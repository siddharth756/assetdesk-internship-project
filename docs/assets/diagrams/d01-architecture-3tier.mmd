flowchart TD
    subgraph Tier1 ["Presentation Tier (Frontend Client SPA)"]
        direction LR
        UI["React 18 Single Page App<br/>(Vite ESM Bundler)"]
        Router["React Router v6<br/>(Client-Side Routing)"]
        Theme["Vanilla CSS Design System<br/>(Light/Dark Themes & Components)"]
        UI --- Router --- Theme
    end

    subgraph Tier2 ["Application Logic Tier (Node.js & Express REST API Server)"]
        direction LR
        Gateway["Express.js API Gateway<br/>(HTTP Port :5000)"]
        Security["Security Middleware Stack<br/>(Helmet, CORS, RateLimiter)"]
        Controllers["Controllers & RBAC Guards<br/>(Users, Assets, Licenses, Tickets, Audits)"]
        Gateway --> Security --> Controllers
    end

    subgraph Tier3 ["Data & Persistence Tier (MongoDB Atlas & Mongoose ODM)"]
        direction LR
        ODM["Mongoose 8 ODM<br/>(Schema Validation & Hooks)"]
        DB[("MongoDB 8.0 Engine<br/>(B-Tree Compound Indexes)")]
        Data[("Persistent Collections:<br/>users, assets, licenses, tickets, auditlogs")]
        ODM --> DB --> Data
    end

    Tier1 -- "HTTPS REST API Calls (JSON / Bearer JWT)" --> Tier2
    Tier2 -- "Mongoose Driver (TLS Connection Pool)" --> Tier3
