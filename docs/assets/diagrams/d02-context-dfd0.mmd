flowchart LR
    subgraph Users ["User Roles"]
        Admin["System Administrator"]
        Support["IT Support Staff"]
        Employee["Employee / Requester"]
    end

    System(["0.0<br/><b>IT Asset & Support Desk<br/>Management System (AssetDesk)</b>"])

    External["External SMTP Mailer"]

    %% Admin flows
