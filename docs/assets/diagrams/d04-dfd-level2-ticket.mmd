flowchart LR
    subgraph S1 ["1. Ticket Submission & SLA"]
        direction TB
        Emp["Employee User"] -->|Submit Issue| P1(["5.1 Register Ticket"])
        P1 -->|Compute Deadline| P2(["5.2 SLA Due Date Engine"])
        P2 -->|Save OPEN Ticket| D1[("D4: Tickets Database")]
    end

    subgraph S2 ["2. Support Triage & Discussion"]
        direction TB
        Tech["IT Support Staff"] -->|Claim Incident| P3(["5.3 Technician Triage"])
        P3 -->|Set IN_PROGRESS| D2[("D4: Tickets Database")]
        P3 -->|Exchange Messages| P4(["5.4 Two-Way Discussion"])
        P4 -->|Append Comments| D2
    end

    subgraph S3 ["3. Resolution & Closure"]
        direction TB
        P5(["5.5 Validate Solution<br/>(Note &ge; 5 Chars)"]) -->|Set RESOLVED| D3[("D4: Tickets Database")]
        D3 -->|Requester Review| P6(["5.6 Confirm & Close"])
        P6 -->|Set CLOSED Immutable| D3
        P6 -.->|Log Final Event| D5[("D5: AuditLogs")]
    end

    S1 ==> S2 ==> S3
