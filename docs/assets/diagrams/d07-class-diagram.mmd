classDiagram
    direction TB
    class User {
        +ObjectId _id
        +String name
        +String email
        +String role
        +String department
        +Boolean isActive
        +comparePassword(pwd) Boolean
    }

    class Asset {
        +ObjectId _id
        +String assetTag
        +String serialNumber
        +String category
        +String status
        +ObjectId assignedTo
        +Date assignedAt
    }

    class License {
        +ObjectId _id
        +String softwareName
        +String vendor
        +Number totalSeats
        +Number usedSeats
        +Date expiryDate
    }

    class Ticket {
        +ObjectId _id
        +String ticketCode
        +String title
        +String priority
        +String status
        +ObjectId createdBy
        +ObjectId assignedTo
        +Date dueAt
    }

    class Comment {
        +ObjectId author
        +String message
        +Date createdAt
    }

    class AuditLog {
        +ObjectId _id
        +ObjectId user
        +String action
        +String entity
        +String ipAddress
        +Date timestamp
    }

    User "1" <-- "0..*" Asset : assignedTo
    User "1" <-- "0..*" Ticket : createdBy
    User "1" <-- "0..1" Ticket : assignedTo
    Ticket "1" *-- "0..*" Comment : contains
    License "1" <-- "0..*" User : allocates
    User "1" <-- "0..*" AuditLog : actor
