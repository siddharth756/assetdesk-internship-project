erDiagram
    USERS ||--o{ ASSETS : "assignedTo"
    USERS ||--o{ TICKETS : "createdBy"
    USERS ||--o{ TICKETS : "assignedTo"
    USERS ||--o{ AUDIT_LOGS : "actor"
    USERS ||--o{ LICENSES : "allocates"

    USERS {
        ObjectId _id PK
        string name
        string email UK
        string role
        string department
        boolean isActive
    }

    ASSETS {
        ObjectId _id PK
        string assetTag UK
        string serialNumber UK
        string category
        string status
        ObjectId assignedTo FK
    }

    LICENSES {
        ObjectId _id PK
        string softwareName
        string vendor
        int totalSeats
        date expiryDate
    }

    TICKETS {
        ObjectId _id PK
        string ticketCode UK
        string title
        string priority
        string status
        ObjectId assignedTo FK
    }

    AUDIT_LOGS {
        ObjectId _id PK
        ObjectId user FK
        string action
        string entity
        date createdAt
    }
