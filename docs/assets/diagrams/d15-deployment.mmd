flowchart TD
    subgraph Host1 ["1. Client & Global Edge Network Tier (Vercel Global CDN)"]
        direction LR
        Browser["Workstation Web Browser<br/>(Chromium / Firefox / Safari)"]
        CDN["Vercel Global Edge CDN<br/>(HTTPS / HTTP/2 Edge Caching)"]
        SPA["Vite Static Production Assets<br/>(HTML5 / ES-Modules / CSS)"]
        Browser -- "HTTPS :443" --> CDN --> SPA
    end

    subgraph Host2 ["2. Application Container Tier (Render Cloud Linux Container)"]
        direction LR
        Proxy["NGINX Reverse Proxy<br/>(TLS & Rate Limiting)"]
        NodeCluster["Node.js PM2 Process Cluster<br/>(Express 4 REST Server :5000)"]
        Mailer["Nodemailer SMTP Dispatcher<br/>(TLS Port 587)"]
        Proxy --> NodeCluster --> Mailer
    end

    subgraph Host3 ["3. Cloud Database Tier (MongoDB Atlas Cloud Cluster)"]
        direction LR
        Atlas[("MongoDB Atlas Primary Replica<br/>(TLS Encrypted, Automated Backups)")]
        Data[("Persistent BSON Collections:<br/>users, assets, licenses, tickets, auditlogs")]
        Atlas --> Data
    end

    Host1 -- "HTTPS REST API Calls (JSON / Bearer JWT)" --> Host2
    Host2 -- "TLS Connection Pool (mongodb+srv://)" --> Host3
